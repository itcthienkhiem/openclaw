# ─────────────────────────────────────────────────────────────────────────────
# OpenClaw Multi-Tenant Proxy — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Port the proxy listens on
MT_PORT=3000

# Secret key for admin API endpoints (required — generate with: openssl rand -hex 32)
MT_ADMIN_KEY=

# SQLite database path (stores tenant registry)
MT_DB_PATH=./data/tenants.db

# Directory where per-tenant openclaw state is stored
MT_TENANTS_DIR=./data/tenants

# Runtime mode: "process" (default, no Docker needed) or "docker"
MT_MODE=process

# How long (ms) to keep an idle openclaw instance alive (default 30 min)
MT_IDLE_TIMEOUT_MS=1800000

# Allow users to self-register via POST /auth/register (default: true)
# Set to false to disable public registration (admin-only tenant creation)
MT_ALLOW_SELF_REGISTER=true

# App name shown in the portal UI
MT_APP_NAME=OpenClaw

# ── process mode settings ────────────────────────────────────────────────────

# Node.js binary to use when spawning openclaw (default: "node")
OPENCLAW_NODE_BIN=node

# Absolute path to openclaw's dist/index.js entry point
# If multi-tenant/ lives inside the openclaw repo, this default works:
OPENCLAW_MAIN=../dist/index.js

# ── docker mode settings ─────────────────────────────────────────────────────

# Docker image for openclaw (used when MT_MODE=docker)
OPENCLAW_IMAGE=openclaw:local
